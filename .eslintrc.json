{
  "root": true,
  "env": { "browser": true, "node": true, "es2022": true, "jest": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "overrides": [
    {
      "files": ["satyam-holidays-react/**/*.{js,jsx}"],
      "plugins": ["react"],
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "ecmaFeatures": { "jsx": true }
      },
      "extends": ["prettier"],
      "rules": { "react/prop-types": "off", "react/react-in-jsx-scope": "off" }
    },
    {
      "files": ["satyam-holidays-backend/**/*.js"],
      "extends": ["eslint:recommended", "prettier"],
      "env": { "browser": false, "node": true }
    }
  ]
}
