# Production Environment Configuration Template for React Frontend
# Copy to .env.production and fill in values before building

# API Configuration
REACT_APP_API_BASE=https://api.satyamholidays.com

# CAPTCHA Configuration (must match backend)
REACT_APP_CAPTCHA_PROVIDER=recaptcha_v2
REACT_APP_RECAPTCHA_SITE_KEY=<your-recaptcha-site-key>
# OR for hCaptcha:
# REACT_APP_CAPTCHA_PROVIDER=hcaptcha
# REACT_APP_HCAPTCHA_SITE_KEY=<your-hcaptcha-site-key>

# Feature Flags
REACT_APP_WHATSAPP_ENABLE=true

# Sentry Error Tracking (optional but recommended)
REACT_APP_SENTRY_DSN=<your-sentry-dsn>

# Analytics (optional)
REACT_APP_GA_TRACKING_ID=<your-google-analytics-id>
