:80

root * /usr/share/caddy

# SPA fallback - serve index.html for all non-file routes
try_files {path} /index.html

file_server

# Security headers
header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    X-XSS-Protection "1; mode=block"
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google.com https://www.gstatic.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' http://localhost:5000 https://satyam-holidays.vercel.app https://satyamholidays.vercel.app https://www.satyamholidays.com https://api.satyamholidays.com wss://satyam-holidays.vercel.app wss://api.satyamholidays.com https://*.hcaptcha.com https://hcaptcha.com https://*.sentry.io https://*.recaptcha.net https://www.google.com; img-src 'self' data: https://res.cloudinary.com https://satyam-holidays.vercel.app https://api.satyamholidays.com https://images.unsplash.com https://*.recaptcha.net https://hcaptcha.com https://*.hcaptcha.com; frame-src 'self' https://www.google.com https://recaptcha.net https://hcaptcha.com https://*.hcaptcha.com;"
    -Server
}

# Cache static assets aggressively
@static path /static/*
header @static Cache-Control "public, max-age=31536000, immutable"

# Short cache for HTML
@html path /index.html
header @html Cache-Control "no-cache, no-store, must-revalidate"

# Gzip/Brotli compression
encode gzip zstd
