# API Configuration (Required)
REACT_APP_API_BASE=http://localhost:5000

# For production, use your deployed backend URL:
# REACT_APP_API_BASE=https://your-backend.onrender.com

# CAPTCHA Configuration (Recommended for production)
# Choose one provider: recaptcha_v2 | recaptcha_v3 | hcaptcha
REACT_APP_CAPTCHA_PROVIDER=recaptcha_v2

# If using Google reCAPTCHA (get keys at https://www.google.com/recaptcha)
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# If using hCaptcha (get keys at https://www.hcaptcha.com)
# REACT_APP_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Sentry Error Tracking (Recommended for production)
# Sign up at https://sentry.io and get your DSN
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
