# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection (Required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/satyam-holidays
# Set true only when you intentionally use non-Atlas MongoDB in production
ALLOW_NON_ATLAS_DB=false

# JWT Authentication (Required - use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters

# Admin Credentials (Required - change these in production!)
ADMIN_EMAIL=admin@satyamholidays.com
ADMIN_PASSWORD=YourSecurePassword123!

# CORS Configuration (Required - add your frontend URLs)
CORS_ORIGIN=https://your-frontend.vercel.app
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# HTTPS Redirect (recommended for production)
ENFORCE_HTTPS=true

# Base API URL used by verification script
API_BASE_URL=https://api.yourdomain.com

# Email Configuration (Required for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Branding (optional; company logo/name also come from Admin Settings)
EMAIL_BRAND_LOGO_URL=https://your-domain.com/satyam-logo.svg
EMAIL_BRAND_PRIMARY=#f59e0b
EMAIL_BRAND_SECONDARY=#ea580c
PUBLIC_SITE_URL=https://your-domain.com
EMAIL_LOCALE=en

# CAPTCHA Configuration (Required for production)
CAPTCHA_PROVIDER=recaptcha_v2
RECAPTCHA_SECRET=your-recaptcha-secret-key
CAPTCHA_ENFORCE=true

# Redis Configuration (Optional - for caching)
# Uncomment if using Redis for caching
# REDIS_URL=redis://default:password@host:port
# REDIS_REQUIRED=true

# Sentry Error Tracking (Recommended for production)
# Sign up at https://sentry.io and get your DSN
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Verification email target (used by npm run ops:verify-production)
VERIFY_EMAIL_TO=ops@yourdomain.com

# WhatsApp Integration (Optional)
# WHATSAPP_ENABLE=true
# WHATSAPP_TOKEN=your-whatsapp-token
# WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
# ADMIN_WHATSAPP=919824737137

# Cloudinary Image Storage (Required for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
