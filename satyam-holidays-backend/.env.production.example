# Production Environment Configuration Template
# Copy this file to .env and fill in all values before deploying

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# MongoDB Configuration (use MongoDB Atlas in production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
ALLOW_NON_ATLAS_DB=false

# JWT Configuration
JWT_SECRET=<generate-a-strong-64-character-random-string>
JWT_EXPIRES_IN=1h

# Admin Credentials (change immediately after first login)
ADMIN_EMAIL=admin@satyamholidays.com
ADMIN_PASSWORD=<strong-password-min-16-chars>

# CORS Configuration
CORS_ORIGIN=https://satyamholidays.com,https://www.satyamholidays.com
FRONTEND_ORIGIN=https://satyamholidays.com
ENFORCE_HTTPS=true
API_BASE_URL=https://api.satyamholidays.com

# Redis Configuration (optional but recommended for caching)
REDIS_URL=redis://<username>:<password>@<host>:<port>
REDIS_REQUIRED=true

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# Email Configuration (SMTP preferred; Gmail fallback supported)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-gmail@gmail.com>
SMTP_PASS=<your-app-password>
EMAIL_USER=<your-gmail@gmail.com>
EMAIL_PASS=<your-app-password>
EMAIL_FROM="Satyam Holidays <noreply@satyamholidays.com>"

# CAPTCHA Configuration (choose one)
CAPTCHA_PROVIDER=recaptcha_v2
CAPTCHA_ENFORCE=true
RECAPTCHA_SITE_KEY=<your-recaptcha-site-key>
RECAPTCHA_SECRET=<your-recaptcha-secret-key>
# OR for hCaptcha:
# CAPTCHA_PROVIDER=hcaptcha
# HCAPTCHA_SITE_KEY=<your-hcaptcha-site-key>
# HCAPTCHA_SECRET=<your-hcaptcha-secret-key>

# Sentry Error Tracking (optional but recommended)
SENTRY_DSN=<your-sentry-dsn>

# Verification email target (used by npm run ops:verify-production)
VERIFY_EMAIL_TO=ops@satyamholidays.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Security Headers
HELMET_CSP_REPORT_URI=<your-csp-report-uri>

# Google reviews on the homepage (Places API "New"). Restrict the key to the Places API.
# The Place ID is set in Admin -> Settings -> Homepage; GOOGLE_PLACE_ID is an optional fallback.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Vercel deploy hook for the FRONTEND project. When set, package changes trigger a rebuild so the
# pre-rendered package pages and sitemap.xml stay current.
FRONTEND_DEPLOY_HOOK_URL=

# Instagram → draft packages (Admin → Instagram). Connecting from the admin screen is preferred;
# these are only a fallback. INSTAGRAM_USER_ID is needed only for Facebook-login tokens.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Reads the flyers (Gujarati/English). Without it, only the caption is parsed.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
