# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/satyam-holidays

# Email Configuration
# Use your SMTP provider credentials (do not commit real secrets)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
# Optional SMTP (recommended for production)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password

# Dev email preview (no real send)
# ETHEREAL_ENABLE=false
# To really send emails in development (use with care)
# EMAIL_SEND_IN_DEV=false

# JWT Secret (for future authentication)
JWT_SECRET=your-super-secret-jwt-key

# CORS Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Redis cache (optional)
# REDIS_URL=redis://localhost:6379

# reCAPTCHA (optional; enable in production)
# CAPTCHA_PROVIDER=recaptcha_v2 # or recaptcha_v3 or hcaptcha
# CAPTCHA_ENFORCE=false # set true to enforce in dev
# RECAPTCHA_SECRET=your-recaptcha-secret
# RECAPTCHA_MIN_SCORE=0.5
# HCAPTCHA_SECRET=your-hcaptcha-secret

# WhatsApp Cloud API (optional)
# Set WHATSAPP_ENABLE=true to enable sending WhatsApp thank-you messages
WHATSAPP_ENABLE=false
# Get these from Meta for Developers (WhatsApp Business)
# WHATSAPP_TOKEN=EAAM...your token...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
